{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mattersyn:preliminary-synthesis:1",
  "$comment": "Exact shape documentation; preliminary_contract.validate_catalog also enforces DOI-derived ID, lowercase DOI, duplicate DOI, inspected locator pages, contiguous distinct operations, quantitative content and private-path exclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "mattersyn-preliminary-synthesis/1"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "doi",
          "title",
          "citation",
          "document_sha256",
          "document_role",
          "source_pages",
          "inspected_pages",
          "material",
          "method_label",
          "scope",
          "deferred",
          "precursors",
          "operations",
          "outcome",
          "missing_fields",
          "review",
          "extraction",
          "evidence_fingerprint"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^prelim-[a-f0-9]{16}$"
          },
          "doi": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^10\\.\\d{4,9}/[^\\s<>\"\\\\?#]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "citation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "document_role": {
            "enum": [
              "main",
              "si"
            ]
          },
          "source_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "inspected_pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5000,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "uniqueItems": true
          },
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "elements",
              "existing_hub_id"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "elements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 118,
                "items": {
                  "enum": [
                    "Ac",
                    "Ag",
                    "Al",
                    "Am",
                    "Ar",
                    "As",
                    "At",
                    "Au",
                    "B",
                    "Ba",
                    "Be",
                    "Bh",
                    "Bi",
                    "Bk",
                    "Br",
                    "C",
                    "Ca",
                    "Cd",
                    "Ce",
                    "Cf",
                    "Cl",
                    "Cm",
                    "Cn",
                    "Co",
                    "Cr",
                    "Cs",
                    "Cu",
                    "Db",
                    "Ds",
                    "Dy",
                    "Er",
                    "Es",
                    "Eu",
                    "F",
                    "Fe",
                    "Fl",
                    "Fm",
                    "Fr",
                    "Ga",
                    "Gd",
                    "Ge",
                    "H",
                    "He",
                    "Hf",
                    "Hg",
                    "Ho",
                    "Hs",
                    "I",
                    "In",
                    "Ir",
                    "K",
                    "Kr",
                    "La",
                    "Li",
                    "Lr",
                    "Lu",
                    "Lv",
                    "Mc",
                    "Md",
                    "Mg",
                    "Mn",
                    "Mo",
                    "Mt",
                    "N",
                    "Na",
                    "Nb",
                    "Nd",
                    "Ne",
                    "Nh",
                    "Ni",
                    "No",
                    "Np",
                    "O",
                    "Og",
                    "Os",
                    "P",
                    "Pa",
                    "Pb",
                    "Pd",
                    "Pm",
                    "Po",
                    "Pr",
                    "Pt",
                    "Pu",
                    "Ra",
                    "Rb",
                    "Re",
                    "Rf",
                    "Rg",
                    "Rh",
                    "Rn",
                    "Ru",
                    "S",
                    "Sb",
                    "Sc",
                    "Se",
                    "Sg",
                    "Si",
                    "Sm",
                    "Sn",
                    "Sr",
                    "Ta",
                    "Tb",
                    "Tc",
                    "Te",
                    "Th",
                    "Ti",
                    "Tl",
                    "Tm",
                    "Ts",
                    "U",
                    "V",
                    "W",
                    "Xe",
                    "Y",
                    "Yb",
                    "Zn",
                    "Zr"
                  ]
                },
                "uniqueItems": true
              },
              "existing_hub_id": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                ]
              }
            }
          },
          "method_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "deferred": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "precursors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "amount",
                "role",
                "locators"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "amount": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  ]
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "locators": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "page",
                      "section"
                    ],
                    "properties": {
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "section": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    }
                  }
                }
              }
            }
          },
          "operations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "action",
                "conditions",
                "locators"
              ],
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "conditions": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "parameter",
                      "reported"
                    ],
                    "properties": {
                      "parameter": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "reported": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      }
                    }
                  }
                },
                "locators": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "page",
                      "section"
                    ],
                    "properties": {
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "section": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    }
                  }
                }
              }
            }
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_label",
              "link_basis",
              "descriptors",
              "locators"
            ],
            "properties": {
              "sample_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "link_basis": {
                "type": "string",
                "minLength": 16,
                "maxLength": 600
              },
              "descriptors": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "reported",
                    "technique",
                    "locators"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "phase",
                        "composition",
                        "morphology",
                        "size",
                        "architecture"
                      ]
                    },
                    "reported": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 320
                    },
                    "technique": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "locators": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "page",
                          "section"
                        ],
                        "properties": {
                          "page": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5000
                          },
                          "section": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          }
                        }
                      }
                    }
                  }
                }
              },
              "locators": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "page",
                    "section"
                  ],
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5000
                    },
                    "section": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  }
                }
              }
            }
          },
          "missing_fields": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tier",
              "author_source_checked",
              "independent_audit",
              "accuracy",
              "training_ready"
            ],
            "properties": {
              "tier": {
                "const": "preliminary"
              },
              "author_source_checked": {
                "const": true
              },
              "independent_audit": {
                "const": "pending"
              },
              "accuracy": {
                "const": "unmeasured"
              },
              "training_ready": {
                "const": false
              }
            }
          },
          "extraction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "recipe_scope_complete",
              "omitted_variants",
              "source_identity_checked"
            ],
            "properties": {
              "origin": {
                "enum": [
                  "assistant_source_checked",
                  "local_model_source_checked"
                ]
              },
              "recipe_scope_complete": {
                "const": true
              },
              "omitted_variants": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "source_identity_checked": {
                "const": true
              }
            }
          },
          "evidence_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
