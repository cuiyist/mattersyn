  "source_notes": [
    {
      "id": "interpretation-0",
      "label": "Two preparation routes, two material outcomes",
      "summary": "The PAA-coated NC sample is precipitated from acetate stocks and sulfide, then dried with acrylic acid. SMP is made by treating existing ZnS particles with manganese acetate and ammonia, followed by nitrogen firing. The two EPR signals are coordination environments within a sample, not additional syntheses.",
      "source_locators": [
        "Main PDF p. 2–3, Preparation, Table 2 and EPR assignment"
      ]
    },
    {
      "id": "interpretation-1",
      "label": "Quantum confinement and the imperfect-coating possibility",
      "summary": "The authors relate the higher-energy NC excitation band to quantum confinement. Its reported 3.78 eV peak differs from a 4.2 eV effective-mass prediction based on measured size; they discuss coagulation and imperfect PAA coating as possible explanations. The 4.2 eV prediction and cited approximately 2.5 nm exciton Bohr radius are model/reference context, not new measurements.",
      "source_locators": [
        "Main PDF p. 3, Figure 2 and size discussion"
      ]
    },
    {
      "id": "interpretation-2",
      "label": "Symmetry and dopant-site interpretation",
      "summary": "Signal I is assigned to substitutional Mn2+ coordinated by four sulfide ions in cubic ZnS. Larger zero-field splitting and lattice distortion in NC are interpreted as lower crystal-field symmetry. Signal II, detected only for NC at Q-band, is assigned to near-surface Mn2+; its larger hyperfine splitting is linked to more ionic coordination.",
      "source_locators": [
        "Main PDF p. 3–5, Tables 1–2 and Figures 3–6"
      ]
    },
    {
      "id": "interpretation-3",
      "label": "Polymer coordination and oxidation",
      "summary": "The source compares sulfate-related IR bands in uncoated ZnS:Mn with the PAA-coated NC spectrum and proposes carboxyl oxygen coordination near Mn sites. Cited prior XPS evidence is not newly measured in this main. This is a source-attributed coordination interpretation, not an atom-resolved shell structure.",
      "source_locators": [
        "Main PDF p. 4–5, Figure 6 and oxygen-coordination discussion"
      ]
    },
    {
      "id": "interpretation-4",
      "label": "Temperature-independent EPR linewidth and energy transfer",
      "summary": "NC signals I and II show little linewidth change while SMP signal I narrows on cooling. With the assumption of a temperature-independent spin–spin term, the authors infer stronger spin–lattice interactions and more effective ZnS–Mn and PAA–Mn energy transfer. No numerical T1 lifetime or fitted temperature exponent is reported.",
      "source_locators": [
        "Main PDF p. 5–6, Figure 7 and relaxation discussion"
      ]
    },
    {
      "id": "interpretation-5",
      "label": "Relative luminescence is not absolute quantum yield",
      "summary": "The source reports sevenfold greater NC luminescence under the same stated 350 nm excitation despite lower measured Mn content. It favors greater luminescence efficiency over reduced scattering because these small particles coagulate and acrylic acid accelerates coagulation. No absolute quantum yield or controlled scattering correction is supplied.",
      "source_locators": [
        "Main PDF p. 2, Figure 1 discussion"
      ]
    }
  ],
  "evidence_conflicts": [
